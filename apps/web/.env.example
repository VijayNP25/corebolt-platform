# Public API base (Express). Trailing path should include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Site origin for canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default currency when no cookie is set (INR | USD)
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Ask Price emails. The Outlook recipient is set on the EmailJS template.
# Template variables: name, email, reply_to, mobile, company, product, topic, message.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
