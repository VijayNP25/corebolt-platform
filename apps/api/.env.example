NODE_ENV=development
PORT=4000
# Local (no Docker): file-backed Postgres-compatible DB
DATABASE_URL=pglite:./.data/pglite
# Real Postgres / Docker Compose:
# DATABASE_URL=postgresql://corebolt:corebolt@localhost:5432/corebolt

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Shop URL used in the email confirmation link
WEB_ORIGIN=http://localhost:3000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# FX. Leave the key empty to use the public USD/INR rate.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
DEFAULT_FX_MARKUP_PERCENT=2.5
GST_PERCENT=18
# Printed on invoices. Intra-state sales (same state as SELLER_STATE) get CGST+SGST, others IGST.
SELLER_NAME=CORE BOLT
SELLER_GSTIN=36AAUFC3215H1ZE
SELLER_STATE=Telangana
SELLER_ADDRESS=Hyderabad, India

# Payments (stubs)
ICICI_MERCHANT_ID=
ICICI_SECRET_KEY=
ICICI_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Amazon SES). Leave the keys empty to log mail locally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=sales@core-bolt.com
SES_REGION=ap-south-1
SES_FROM_NAME=COREBOLT
OPS_NOTIFY_EMAIL=sales@core-bolt.com

# Seed
SEED_ADMIN_EMAIL=admin@core-bolt.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
